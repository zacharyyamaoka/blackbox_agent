# Iterations: one row per iteration (a non-ablation solution with a dev score)
# Stock: every black-box agent ships this file and swaps the data file. Grammar: Obsidian Bases + data-ui keys
# (data-ui docs/CONTRACT.md §5). Data: proposals-pages/_build/fold.py from trajectory_tracking_agent @ 9ead945.
# CONTRACT §24 (Zach, 2026-11-25, "HUman readable iteration names"): the summary beside the id, a peek that leads with
# the summary, then the prediction beside what happened, then the description; facets by family, by any prefix of the
# dotted name (lineage) and by parent. A box that names nothing shows these as missing ("—"), never invented.
# CONTRACT §28 (Zach, 2026-11-25, "Iteration x Dataset … as simple as just adding these views to the iteration page …
# and then kinda like enriching the filter with that information"; "no filters on the columns! I should be able to
# select which different datasets etc I want to be comparing it on"): PICKS B2, one rail, more view tabs. The views
# after Kept only read `task_results` (one row per iteration × scorecard × task, generic over every dataset the box's
# scorecards carry); the rail filters both grains: Dataset, Split, Task kind and Speed pick the columns (on the list
# they keep the iterations that ran one). The host swaps the rows on a `from:` view (data-ui's <data-views> has no
# `from:` yet, §28.4) and joins each task row to its iteration by the link below.
data: iterations.json
datasets:
  task_results: task_results.json
links:
  - { from: task_results.solution, to: iterations.id }
facets:
  - verdict
  - { property: dataset, label: Dataset }
  - { property: split, label: Split }
  - { property: kind, label: Task kind }
  - { property: speed, label: Speed }
  - admissible
  - proposer
  - { property: objective, as: range, label: Dev error (mm) }
  - { property: failed_tasks, as: range }
  - { property: family, label: Family }
  - { property: model, label: Model }
  - { property: lineage, label: Name starts with, searchable: true }
  - parent
open: { mode: side, splitAt: 980 }
properties:
  n: { displayName: "#", type: number, decimals: 0 }
  id: { displayName: "Solution" }
  name: { displayName: "Name" }
  summary: { displayName: "Summary" }
  description: { displayName: "Description" }
  expect: { displayName: "Expected (stated before the run)" }
  expect_status: { displayName: "When it was stated" }
  family: { displayName: "Family" }
  lineage: { displayName: "Name starts with" }
  verdict: { displayName: "Verdict" }
  objective: { displayName: "Dev error", type: number, decimals: 3 }
  best_so_far: { displayName: "Best so far", type: number, decimals: 3 }
  holdout: { displayName: "Holdout", type: number, decimals: 3 }
  admissible: { displayName: "Admissible" }
  gen: { displayName: "Depth", type: number, decimals: 0 }
  parent: { displayName: "Parent" }
  change: { displayName: "The one change" }
  evaluated: { displayName: "Evaluated" }
  created: { displayName: "Created" }
  tags: { displayName: "Tags" }
  gate_pass_rate: { displayName: "Gate pass rate", type: number, decimals: 3 }
  best_holder: { displayName: "Best so far held by" }
  proposer: { displayName: "Proposed by" }
  why: { displayName: "Why this verdict" }
  failed_tasks: { displayName: "Gate failures", type: number, decimals: 0 }
  energy_j: { displayName: "Motor energy", type: number, decimals: 0 }
  stop_error_worst: { displayName: "Worst stop error", type: number, decimals: 3 }
  saturation_worst: { displayName: "Worst saturation", type: number, decimals: 3 }
  g_completed: { displayName: "Completed" }
  g_stop_error_max_mm: { displayName: "Stop error" }
  g_saturation_share_pct: { displayName: "Saturation" }
  g_limit_violations: { displayName: "Limits" }
  g_floor_clearance: { displayName: "Floor" }
  model: { displayName: "Model" }
  iteration: { displayName: "Iteration" }
  solution: { displayName: "Solution" }
  deployment: { displayName: "Deployment" }
  dataset: { displayName: "Dataset" }
  split: { displayName: "Split" }
  dataset_split: { displayName: "Dataset · split" }
  speed: { displayName: "Speed", type: number }
  kind: { displayName: "Task kind" }
  task: { displayName: "Task" }
  value: { displayName: "Objective (this task)", type: number, digits: 4, better: lower }
  gates_passed: { displayName: "Gates passed", type: number, decimals: 0, better: higher }
  gates: { displayName: "Gates", type: number, decimals: 0 }
  gates_failed: { displayName: "Gates failed" }
views:
  - type: table
    name: Iterations
    order: [n, id, summary, verdict, objective, best_so_far, holdout, parent, change, proposer, evaluated]
    sort:
      - { property: n, direction: DESC }
    display: { verdict: status, description: markdown }
    record:
      sections:
        - { name: "", properties: [name, summary] }
        - { name: "Expected vs what happened", properties: [expect, expect_status, objective, verdict, best_so_far] }
        - { name: "Description", properties: [description] }
        - { name: "Details", properties: [n, change, parent, holdout, admissible, proposer, evaluated, gen, family, lineage, gate_pass_rate, failed_tasks, best_holder, created, tags] }
  - type: lineage
    name: Lineage
    order: [id, verdict, objective, holdout, parent, change, proposer]
    lineage:
      parents: parent
      label: id
      focus: p5s-pass3
      kept: { admissible: [true] }
      extinct: show
  - type: chart
    name: Progress
    order: [n, id, verdict, objective, best_so_far, change]
    chart:
      layer:
        - mark: { type: line, interpolate: step-after, color: "var(--data-series-2)", strokeWidth: 2 }
          encoding:
            x: { field: n, type: quantitative, title: iteration (first dev evaluation order), axis: { tickMinStep: 1 } }
            y: { field: best_so_far, type: quantitative, scale: { type: log }, title: dev error (mm, log) }
        - mark: { type: point, filled: true, size: 70, opacity: 0.9 }
          encoding:
            x: { field: n, type: quantitative }
            y: { field: objective, type: quantitative, scale: { type: log } }
            color:
              field: verdict
              type: nominal
              title: verdict
              scale: { domain: [kept, discarded, failed], range: ["#2a9d3a", "#9aa1aa", "#d62728"] }
            tooltip: [{ field: n }, { field: id, title: solution }, { field: verdict }, { field: objective, format: ".4f" }, { field: change }]
  - type: table
    name: Gate matrix
    order: [n, id, verdict, g_completed, g_stop_error_max_mm, g_saturation_share_pct, g_limit_violations, g_floor_clearance, stop_error_worst, saturation_worst, failed_tasks]
    sort:
      - { property: n, direction: ASC }
    display: { verdict: status, g_completed: status, g_stop_error_max_mm: status, g_saturation_share_pct: status, g_limit_violations: status, g_floor_clearance: status }
  - type: table
    name: Kept only
    filters: 'verdict == "kept"'
    order: [n, id, objective, holdout, parent, change]
    sort:
      - { property: n, direction: ASC }
  - type: pivot
    name: × Dataset
    from: task_results
    splitBy: [deployment, split, dataset, kind, task]
    value: { property: value, summary: Median }
    pivot:
      rows: [iteration]
      roles: { deployment: deployment, split: group, dataset: dataset, kind: kind, task: unit }
      rollup: median
      metrics: [value, gates_passed]
      color: rank
      interval: median
      layout: compact
      fold: { rows: closed, columns: 3 }
      headers: horizontal
  - type: pivot
    name: × Dataset · by family
    from: task_results
    splitBy: [deployment, split, dataset, kind, task]
    value: { property: value, summary: Median }
    pivot:
      rows: [family, model, iteration]
      roles: { deployment: deployment, split: group, dataset: dataset, kind: kind, task: unit }
      rollup: median
      metrics: [value, gates_passed]
      color: rank
      interval: median
      layout: compact
      fold: { rows: open, columns: 3 }
      headers: horizontal
  - type: chart
    name: Progress by dataset
    from: task_results
    order: [n, iteration, dataset_split, kind, task, value]
    chart:
      layer:
        - mark: { type: line, point: true, strokeWidth: 2 }
          encoding:
            x: { field: n, type: quantitative, title: iteration (first dev evaluation order), axis: { tickMinStep: 1 } }
            y: { field: value, type: quantitative, aggregate: median, scale: { type: log }, title: "median over each dataset's tasks (log)" }
            color: { field: dataset_split, type: nominal, title: dataset · split }
            tooltip: [{ field: n, title: iteration }, { field: dataset_split, title: dataset · split }, { field: value, aggregate: median, format: ".4f", title: median }]
  - type: table
    name: Task rows
    from: task_results
    order: [iteration, verdict, deployment, split, dataset, kind, task, value, gates_passed, gates_failed]
    groupBy: { property: iteration }
    fold: closed
    display: { verdict: status }
